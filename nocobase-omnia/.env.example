NOCOBASE_VERSION=2.0.60
NOCOBASE_PORT=13000
APP_KEY=replace-with-a-long-random-value

POSTGRES_DB=nocobase
POSTGRES_USER=nocobase
POSTGRES_PASSWORD=replace-with-a-strong-password

# From the app container, host.docker.internal reaches an adapter running on the host.
OMNIA_ADAPTER_URL=http://host.docker.internal:8890
OMNIA_ADAPTER_TIMEOUT_MS=8000

INIT_ROOT_EMAIL=admin@example.invalid
INIT_ROOT_PASSWORD=replace-before-first-start
INIT_ROOT_NICKNAME=Omnia Admin
INIT_ROOT_USERNAME=admin

